    "dotenv": "^16.4.5",
    "nodemon": "^3.1.11",
    "pino-pretty": "^13.1.3",
    "ts-node": "^10.9.2",
    "ts-standard": "^12.0.2",
    "typescript": "^5.5.3"
  },
  "private": true,
  "ts-standard": {
    "ignore": [
      "dist"
    ]
  }
}

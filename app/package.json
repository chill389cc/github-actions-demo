{
  "name": "website",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "NODE_ENV=development nodemon  -e js,ts,html,json --exec node -r ts-node/register -r dotenv/config src/index.ts",
